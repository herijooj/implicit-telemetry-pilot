# Telemetry Forms Pilot — env config (copy to .env or export)
# Single config file/env per spec §2
APP_VERSION=0.1.0-pilot
PORT=3000
DASHBOARD_PASSWORD=change-me-pilot
CONFIRM_RATE=0.5
SAMPLING_MS=50
IDLE_PAUSE_MS=2000
DATA_DIR=./data
CONSENT_TEXT_VERSION=v1
# Ethics/contact placeholders (§15) — replace before real collection
CONTACT_TEXT="Contact: [YOUR NAME / LAB], [EMAIL]. Ethics: [IRB / EXEMPTION REF]."
DATA_RETENTION_DAYS=0
